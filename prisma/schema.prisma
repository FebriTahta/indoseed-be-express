// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String     @id @default(uuid())
  username        String     @unique
  email           String     @unique
  password        String
  isEmailVerified Boolean    @default(false)
  defaultRoleId   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles           UserRole[]
  defaultRole     Role?      @relation("DefaultRole", fields: [defaultRoleId], references: [id])
  otps            EmailOtp[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userRoles   UserRole[]
  defaultFor  User[]     @relation("DefaultRole")

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model EmailOtp {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_otps")
}

model Greenhouse {
  id              String   @id @default(uuid())
  kodeLahan       String   @unique
  namaLahan       String
  jenisLahan      String   @default("Greenhouse")
  komoditasUtama  String
  komoditasColor  String   @default("emerald")
  komoditasIcon   String   @default("ri-leaf-line")
  lokasi          String
  luas            Float
  status          String   @default("Aktif")
  detailLokasi    String?  @db.Text
  koordinat       String?
  petaniMitra     String?
  commodityId     String?
  partnerId       String?
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  keterangan      String?  @db.Text
  image           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commodity       Commodity? @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  partner         Partner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@map("greenhouses")
}

model Commodity {
  id              String   @id @default(uuid())
  kodeKomoditas   String   @unique
  namaKomoditas   String
  kategori        String
  deskripsi       String?  @db.Text
  status          String   @default("Aktif")
  image           String?  @db.Text
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  tglDiubah       DateTime @default(now()) @updatedAt
  diubahOleh      String?  @default("Admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  varieties       Variety[]
  greenhouses     Greenhouse[]

  @@map("commodities")
}

model Variety {
  id             String    @id @default(uuid())
  kodeVarietas   String    @unique
  namaVarietas   String
  commodityId    String
  asalPemulia    String?
  tahunRilis     Int?
  deskripsi      String?   @db.Text
  umurTanam      String?
  tinggiTanaman  String?
  bentukBiji     String?
  warnaGabah     String?
  potensiHasil   String?
  anjuranDataran String?
  status         String    @default("Aktif")
  image          String?   @db.Text
  tglDibuat      DateTime  @default(now())
  dibuatOleh     String?   @default("Admin")
  tglDiubah      DateTime  @default(now()) @updatedAt
  diubahOleh     String?   @default("Admin")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commodity      Commodity @relation(fields: [commodityId], references: [id], onDelete: Cascade)

  @@map("varieties")
}
model Partner {
  id              String   @id @default(uuid())
  kodePetani      String   @unique
  namaPetani      String
  kelompokTani    String
  komoditasUtama  String
  noKtp           String?
  noTelepon       String?
  alamat          String?  @db.Text
  luasLahan       Float    @default(0.0) // Luas Lahan (Ha)
  pengalaman      Int      @default(0)   // Pengalaman Bertani (tahun)
  tglBergabung    DateTime @default(now())
  status          String   @default("Aktif")
  image           String?  @db.Text
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  tglDiubah       DateTime @default(now()) @updatedAt
  diubahOleh      String?  @default("Admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  greenhouses     Greenhouse[]

  @@map("partners")
}

model Customer {
  id              String   @id @default(uuid())
  kodeCust      String   @unique
  namaCust      String
  pic           String
  kategori      String
  email         String
  NPWP          String?
  noTelepon     String?
  kota          String
  kodePos       String?
  alamat        String?
  isTop         Boolean  @default(false)
  limitKredit   Float    @default(0.0)
  remainKredit  Float    @default(0.0)
  tglBergabung    DateTime @default(now())
  status          String   @default("Aktif")
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  tglDiubah       DateTime @default(now()) @updatedAt
  diubahOleh      String?  @default("Admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("customers")
}

model Gudang {
  id              String   @id @default(uuid())
  kodeGudang      String   @unique
  namaGudang      String
  kategori      String
  alamat        String?
  status          String   @default("Aktif")
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  tglDiubah       DateTime @default(now()) @updatedAt
  diubahOleh      String?  @default("Admin")

  @@map("gudangs")
}

model Supplier {
  id              String   @id @default(uuid())
  kodeSupplier      String   @unique
  namaSupplier      String
  kategori      String
  alamat        String?
  status          String   @default("Aktif")
  tglDibuat       DateTime @default(now())
  dibuatOleh      String?  @default("Admin")
  tglDiubah       DateTime @default(now()) @updatedAt
  diubahOleh      String?  @default("Admin")

  @@map("suppliers")
}

