/// Jejak audit seluruh aktivitas pengguna (create / update / delete / login / logout).
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  username    String
  role        String?
  modul       String
  aksi        String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entitas     String?  // jenis data, mis. "Uji Kadar Air"
  entitasId   String?
  entitasKode String?  // nomor / kode yang mudah dibaca, mis. "TST-QC-2026-00002"
  keterangan  String   @db.Text
  /// [{ field, label, sebelum, sesudah }]
  perubahan   Json?
  metode      String?  // HTTP method
  endpoint    String?  @db.VarChar(500)
  ipAddress   String?
  userAgent   String?  @db.Text
  perangkat   String?  // mis. "Chrome (Windows)"
  /// Username superadmin bila aktivitas dilakukan melalui fitur "login sebagai".
  impersonatedBy String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([username])
  @@index([modul])
  @@index([aksi])
  @@index([entitas])
  @@map("audit_logs")
}
